{
  // Cloudflare Workers config: static site plus the contact form API.
  "name": "angusgee-dev",
  "main": "worker.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "info@angusgee.dev" }
  ]
}
